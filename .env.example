# Application
NODE_ENV=development
ZAYLOQ_ENV=development

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Control Plane
ZAYLOQ_API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://zayloq:zayloq@localhost:5432/zayloq

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
AUTH_SECRET=replace-with-local-secret

# AI Providers
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=OPENAI
AI_FAST_MODEL=
AI_REASONING_MODEL=
AI_GENERATION_MODEL=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_REQUEST_CHARS=200000
AI_RETRY_ATTEMPTS=2
AI_GLOBAL_CONCURRENCY=20
AI_ORGANIZATION_CONCURRENCY=5
AI_USER_CONCURRENCY=2
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=

# Runtime
BUILD_TIMEOUT_SECONDS=600
BUILD_MAX_MEMORY_MB=2048

# Observability
LOG_LEVEL=debug
