generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EnvironmentType {
  DEVELOPMENT
  PREVIEW
  PRODUCTION
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  displayName     String?   @db.VarChar(160)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             Membership[]
  auditEvents             AuditEvent[]             @relation("AuditActor")
  credentials             UserCredential[]
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([createdAt])
  @@map("users")
}

model Organization {
  id         String             @id @default(uuid()) @db.Uuid
  name       String             @db.VarChar(160)
  slug       String             @unique @db.VarChar(100)
  status     OrganizationStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  archivedAt DateTime?

  memberships Membership[]
  projects    Project[]
  auditEvents AuditEvent[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId])
  @@map("memberships")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String        @db.VarChar(160)
  slug           String        @db.VarChar(100)
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments ProjectEnvironment[]
  auditEvents  AuditEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([createdAt])
  @@map("projects")
}

model ProjectEnvironment {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  type      EnvironmentType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId])
  @@map("project_environments")
}

model AuditEvent {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  projectId      String? @db.Uuid
  actorUserId    String? @db.Uuid

  action       String  @db.VarChar(160)
  resourceType String  @db.VarChar(100)
  resourceId   String? @db.VarChar(160)
  metadata     Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  GITHUB
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model UserCredential {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  provider     AuthProvider @default(PASSWORD)
  providerKey  String?      @db.VarChar(320)
  passwordHash String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, providerKey])
  @@index([userId])
  @@map("user_credentials")
}

model AuthSession {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  tokenHash    String        @unique @db.VarChar(128)
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  revokeReason String?       @db.VarChar(255)
  ipAddress    String?       @db.VarChar(64)
  userAgent    String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
